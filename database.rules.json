{
  "rules": {
    "users": {
      ".read": true,
      "$username": {
        ".write": true,
        "role":    { ".validate": "newData.val() === 'admin' || newData.val() === 'entry' || newData.val() === 'manager'" },
        "name":    { ".validate": "newData.isString() && newData.val().length > 0" },
        "pinHash": { ".validate": "newData.isString() && newData.val().length === 64" },
        "site":    { ".validate": "!newData.exists() || newData.val() === 'A' || newData.val() === 'B'" },
        "$other":  { ".validate": false }
      }
    },

    "people": {
      ".read":  true,
      ".write": true,
      "$personId": {
        "name":   { ".validate": "newData.isString() && newData.val().length > 0" },
        "site":   { ".validate": "newData.val() === 'A' || newData.val() === 'B'" },
        "active": { ".validate": "newData.isBoolean()" },
        "$other": { ".validate": false }
      }
    },

    "periods": {
      ".read":  true,
      ".write": true,
      "$periodId": {
        "name":            { ".validate": "newData.isString() && newData.val().length > 0" },
        "startingBalance": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "status":          { ".validate": "newData.val() === 'Draft' || newData.val() === 'Active' || newData.val() === 'Closed'" },
        "$other":          { ".validate": false }
      }
    },

    "invoices": {
      ".read":  true,
      ".write": true,
      "$invoiceId": {
        ".validate": "newData.hasChildren(['periodId','invoiceNo','date','vendor','status'])",
        "invoiceNo":           { ".validate": "newData.isString() && newData.val().length > 0" },
        "date":                { ".validate": "newData.isString()" },
        "vendor":              { ".validate": "newData.isString() && newData.val().length > 0" },
        "periodId":            { ".validate": "newData.isString()" },
        "status":              { ".validate": "newData.val() === 'Draft' || newData.val() === 'Submitted'" },
        "grandTotal":          { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)" },
        "enteredByUid":        { ".validate": "!newData.exists() || newData.isString()" },
        "enteredByName":       { ".validate": "!newData.exists() || newData.isString()" },
        "purchasedByPersonId": { ".validate": "!newData.exists() || newData.isString()" },
        "purchasedByName":     { ".validate": "!newData.exists() || newData.isString()" },
        "$other":              { ".validate": true }
      }
    },

    "invoiceComments": {
      ".read":  true,
      ".write": true
    },

    "advances": {
      ".read":  true,
      ".write": true,
      "$advanceId": {
        "amount":       { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() > 0)" },
        "status":       { ".validate": "!newData.exists() || newData.val() === 'Open' || newData.val() === 'Settled' || newData.val() === 'Overspent'" },
        "cashReturned": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)" },
        "$other":       { ".validate": true }
      }
    },

    "auditLog": {
      ".read":  true,
      ".write": true
    },

    "v2": {
      ".read":  true,
      ".write": true
    }
  }
}
